# --- IDE Specific Files ---
# Ignore le dossier de configuration d'IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Ignore les fichiers de Visual Studio Code
.vscode/
*.code-workspace

# Ignore les fichiers Eclipse
.settings/
.classpath
.project
bin/

# --- Build & Output ---
# Ignore les dossiers de compilation Maven (très important !)
**/target/

# Ignore les dossiers de compilation Gradle
**/.gradle/
**/build/

# --- System Files ---
.DS_Store
Thumbs.db
*.log

# --- Optional: Local configuration ---
*.properties
*.local
# Compiled class file
*.class

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
